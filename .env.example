# STAYLO — Environment variables
# Copy to .env and fill in values. Backend reads backend/.env; frontend uses REACT_APP_* at build time.

# ============== BACKEND (required for server startup) ==============
MONGO_URL=mongodb://localhost:27017
DB_NAME=staylo_db

# ============== BACKEND (production mode) ==============
# Set ENVIRONMENT=production to enforce: JWT_SECRET_KEY must be set and not default; CORS_ORIGINS must be explicit (no *).
# Leave unset or non-production for local development (defaults allowed).
# ENVIRONMENT=production

# ============== BACKEND (recommended / optional) ==============
JWT_SECRET_KEY=change-me-in-production-use-strong-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
SENDER_EMAIL=onboarding@resend.dev
HOTEL_NOTIFICATION_EMAIL=

# ============== FRONTEND (build-time; used by React app) ==============
REACT_APP_BACKEND_URL=http://localhost:8000
